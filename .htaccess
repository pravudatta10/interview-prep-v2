# Apache / shared hosting: serve index.html for any request that isn't
# a real file or directory, so refreshing or opening a client-side route
# (e.g. /learn) directly resolves server-side instead of 404ing.
# See README.md "Deep Links / Refresh".
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
